<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom attributes for our theme -->
    <attr name="colorBackground" format="color" />
    <attr name="colorSurface" format="color" />
    <attr name="colorOnSurface" format="color" />

    <style name="Theme.TodoApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorBackground">#F2F2F7</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">#1C1C1E</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="DialogStyle" parent="Theme.MaterialComponents.Light.Dialog.MinWidth">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowElevation">4dp</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>
</resources>