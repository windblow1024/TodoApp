<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back -->
        <TextView android:id="@+id/backButton"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:gravity="center_vertical"
            android:text="← 返回" android:textColor="@color/colorPrimary"
            android:textSize="16sp" />

        <!-- Title -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="标题 *"
            android:textColor="?attr/colorOnSurface" android:textSize="13sp" />
        <EditText android:id="@+id/titleInput"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:importantForAutofill="no" android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="?attr/colorOnSurface" android:textSize="16sp"
            android:hint="输入任务标题" />

        <!-- Description -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="说明备注"
            android:textColor="?attr/colorOnSurface" android:textSize="13sp" />
        <EditText android:id="@+id/descInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="16dp"
            android:textColor="?attr/colorOnSurface" android:textSize="14sp"
            android:hint="添加备注、URL 链接…" />

        <!-- Priority (Eisenhower Matrix) -->
        <TextView android:id="@+id/priorityEisenhowerLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="优先级 (艾森豪威尔矩阵)"
            android:textColor="?attr/colorOnSurface" android:textSize="13sp" />

        <RadioGroup android:id="@+id/priorityGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="vertical">

            <RadioButton android:id="@+id/radioP0" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="P0 🔴 重要且紧急" android:textColor="?attr/colorOnSurface" />
            <RadioButton android:id="@+id/radioP1" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="P1 🟠 重要不紧急" android:textColor="?attr/colorOnSurface" />
            <RadioButton android:id="@+id/radioP2" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="P2 🟡 紧急不重要" android:textColor="?attr/colorOnSurface" />
            <RadioButton android:id="@+id/radioP3" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="P3 ⚪ 低优先级" android:textColor="?attr/colorOnSurface"
                android:checked="true" />
        </RadioGroup>

        <!-- Priority (Simple High/Medium/Low) -->
        <TextView android:id="@+id/prioritySimpleLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="优先级"
            android:textColor="?attr/colorOnSurface" android:textSize="13sp"
            android:visibility="gone" />

        <RadioGroup android:id="@+id/prioritySimpleGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal"
            android:visibility="gone">

            <RadioButton android:id="@+id/radioHigh" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="🔴 高" android:textColor="#FF3B30" android:checked="true" />
            <RadioButton android:id="@+id/radioMedium" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="🟡 中" android:textColor="#FF9500" />
            <RadioButton android:id="@+id/radioLow" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="⚪ 低" android:textColor="#8E8E93" />
        </RadioGroup>

        <!-- Status -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="状态"
            android:textColor="?attr/colorOnSurface" android:textSize="13sp" />

        <RadioGroup android:id="@+id/statusGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal">

            <RadioButton android:id="@+id/statusTodo" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="待办" android:textColor="?attr/colorOnSurface" android:checked="true" />
            <RadioButton android:id="@+id/statusDoing" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="进行中" android:textColor="?attr/colorOnSurface" />
            <RadioButton android:id="@+id/statusPlanned" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="计划中" android:textColor="?attr/colorOnSurface" />
            <RadioButton android:id="@+id/statusPaused" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="暂停" android:textColor="?attr/colorOnSurface" />
            <RadioButton android:id="@+id/statusDone" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="已完成" android:textColor="?attr/colorOnSurface" />
        </RadioGroup>

        <!-- Category -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="类别"
            android:textColor="?attr/colorOnSurface" android:textSize="13sp" />

        <Spinner android:id="@+id/categorySpinner"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="8dp" />

        <EditText android:id="@+id/customTagInput"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:hint="自定义标签名称"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

        <!-- Start Date -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="开始日期与时间"
            android:textColor="?attr/colorOnSurface" android:textSize="13sp" />

        <LinearLayout android:id="@+id/startDateContainer"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:clickable="true" android:focusable="true"
            android:gravity="center_vertical" android:paddingHorizontal="16dp">

            <TextView android:id="@+id/startDateText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="点击设置" android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Due Date -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="截止日期与时间"
            android:textColor="?attr/colorOnSurface" android:textSize="13sp" />

        <LinearLayout android:id="@+id/dueDateContainer"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:clickable="true" android:focusable="true"
            android:gravity="center_vertical" android:paddingHorizontal="16dp">

            <TextView android:id="@+id/dueDateText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="点击设置" android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Sync Calendar -->
        <CheckBox android:id="@+id/syncCalendarCheck"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="同步到系统日历并提醒"
            android:textColor="?attr/colorOnSurface" />

        <!-- Attachment -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="附件"
            android:textColor="?attr/colorOnSurface" android:textSize="13sp" />

        <Button android:id="@+id/attachButton"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/colorPrimary"
            android:text="📎 添加图片附件"
            android:textColor="@android:color/white" />

        <LinearLayout android:id="@+id/attachmentContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView android:id="@+id/attachmentPreview"
                    android:layout_width="match_parent" android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView android:id="@+id/deleteAttachmentBtn"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="删除附件"
                    android:textColor="#FF3B30"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="horizontal">

            <Button android:id="@+id/deleteButton"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_marginEnd="8dp" android:layout_weight="1"
                android:backgroundTint="#FF3B30"
                android:text="删除" android:textColor="@android:color/white"
                android:visibility="gone" />

            <Button android:id="@+id/saveButton"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_marginStart="8dp" android:layout_weight="1"
                android:backgroundTint="@color/colorPrimary"
                android:text="保存" android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>