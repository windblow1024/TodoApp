<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:id="@+id/backButton"
        android:layout_width="wrap_content" android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="← 返回" android:textColor="@color/colorPrimary"
        android:textSize="16sp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="设置" android:textColor="?attr/colorOnSurface"
        android:textSize="18sp" android:textStyle="bold" />

    <!-- 深色模式 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:paddingHorizontal="16dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="深色模式"
            android:textColor="?attr/colorOnSurface" android:textSize="16sp" />
        <Switch android:id="@+id/darkModeSwitch"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 优先级模式 -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="优先级模式"
        android:textColor="?attr/colorOnSurface" android:textSize="14sp" />

    <RadioGroup android:id="@+id/priorityModeGroup"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <RadioButton android:id="@+id/radioPriorityEisenhower" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="艾森豪威尔矩阵" android:textColor="?attr/colorOnSurface" />
        <RadioButton android:id="@+id/radioPrioritySimple" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="高/中/低" android:textColor="?attr/colorOnSurface" android:checked="true" />
    </RadioGroup>

    <!-- 主题色 -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="主题色"
        android:textColor="?attr/colorOnSurface" android:textSize="14sp" />

    <RadioGroup android:id="@+id/themeGroup"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <RadioButton android:id="@+id/radioBlue" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="蓝色" android:textColor="?attr/colorOnSurface" />
        <RadioButton android:id="@+id/radioGreen" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="绿色" android:textColor="?attr/colorOnSurface" />
        <RadioButton android:id="@+id/radioPurple" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="紫色" android:textColor="?attr/colorOnSurface" />
        <RadioButton android:id="@+id/radioOrange" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="橙色" android:textColor="?attr/colorOnSurface" />
    </RadioGroup>

    <!-- 版权信息 -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="32dp" android:gravity="center"
        android:text="待办清单 v1.0&#10;作者: 风吹吹&#10;E-mail: windblow78@qq.com"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        android:alpha="0.6" />

</LinearLayout>
